graph LR
    subgraph "User Actions"
        A1[Register]
        A2[Login]
        A3[Create Project]
        A4[Submit Contribution]
        A5[Accept/Decline]
        A6[View Dashboard]
    end

    subgraph "Frontend Layer"
        B1[Form Validation<br/>Zod]
        B2[API Client<br/>Axios]
        B3[State Management<br/>TanStack Query]
        B4[UI Rendering<br/>React]
    end

    subgraph "Backend API"
        C1[Authentication<br/>JWT Verify]
        C2[Serialization<br/>DRF]
        C3[Validation<br/>DRF Serializers]
        C4[Permissions<br/>Custom + DRF]
    end

    subgraph "Service Layer"
        D1[create_user]
        D2[create_project]
        D3[accept_contribution]
        D4[award_credit]
        D5[update_reputation]
    end

    subgraph "Data Layer"
        E1[(PostgreSQL<br/>Users)]
        E2[(PostgreSQL<br/>Projects)]
        E3[(PostgreSQL<br/>Contributions)]
        E4[(PostgreSQL<br/>Credits)]
        E5[(Redis<br/>Cache)]
    end

    subgraph "Background Tasks"
        F1[Send Email]
        F2[Update Badges]
        F3[Calculate Stats]
    end

    %% Registration Flow
    A1 --> B1 --> B2 --> C1 --> C2 --> D1 --> E1
    E1 -.-> F1

    %% Login Flow
    A2 --> B1 --> B2 --> C1
    C1 --> E1
    E1 --> C2 --> B3 --> B4

    %% Create Project Flow
    A3 --> B1 --> B2 --> C1 --> C4 --> C2 --> D2
    D2 --> E2
    E2 --> C2 --> B3
    B3 --> E5
    B3 --> B4

    %% Contribution Flow
    A4 --> B1 --> B2 --> C1 --> C4 --> C3 --> E2
    E2 --> D3 --> E3

    %% Accept Flow (Atomic)
    A5 --> B2 --> C1 --> C4 --> D3
    D3 --> E3
    D3 --> D4
    D4 --> E4
    D4 --> D5
    D5 --> E1
    E1 -.-> F1
    E1 -.-> F2

    %% View Dashboard
    A6 --> B2 --> C1
    C1 --> E5
    E5 -.->|Cache Miss| E1
    E5 -.->|Cache Miss| E2
    E5 -.->|Cache Miss| E4
    E1 --> E5
    E2 --> E5
    E4 --> E5
    E5 --> B3 --> B4

    %% Styling
    classDef userAction fill:#e3f2fd,stroke:#1976d2
    classDef frontend fill:#f3e5f5,stroke:#7b1fa2
    classDef backend fill:#fff3e0,stroke:#f57c00
    classDef service fill:#e8f5e9,stroke:#388e3c
    classDef data fill:#fce4ec,stroke:#c2185b
    classDef async fill:#fff9c4,stroke:#f9a825

    class A1,A2,A3,A4,A5,A6 userAction
    class B1,B2,B3,B4 frontend
    class C1,C2,C3,C4 backend
    class D1,D2,D3,D4,D5 service
    class E1,E2,E3,E4,E5 data
    class F1,F2,F3 async
